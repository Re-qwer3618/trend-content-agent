# 이 프로젝트 전용 값만 적습니다(git 제외). 공용 API 키는 중앙 .env (_setup\keys.bat set NAME)
#
# 공용 키 (중앙 .env 권장, 없으면 해당 수집기/LLM만 건너뜀)
#   ANTHROPIC_API_KEY        Claude
#   GEMINI_API_KEY           Gemini
#   NAVER_CLIENT_ID          네이버 개발자센터 앱 (검색 + 데이터랩 검색어트렌드 API 사용 설정)
#   NAVER_CLIENT_SECRET
#   YOUTUBE_API_KEY          Google Cloud > YouTube Data API v3
#   INSTAGRAM_ACCESS_TOKEN   (선택) Instagram Graph API, 비즈니스 계정 필요
#   INSTAGRAM_USER_ID        (선택) 위 비즈니스 계정의 IG user id
#   OPENAI_API_KEY           (선택) 이미지 생성 gpt-image-1-mini (DALL-E 3는 2026-05 종료)
#   POLLINATIONS_TOKEN       (선택) 무료 이미지 생성 워터마크 제거 (auth.pollinations.ai 무료 가입)
#   PEXELS_API_KEY           (선택) 쇼츠 장면에 무료 세로 스톡 영상 사용 (pexels.com/api, 무료)

DATA_DIR=./data
REPORT_DIR=./reports
IMAGE_DIR=./images

# 생성 모드
#   prompt = LLM API 호출 없음(비용 0). 기획서 + 웹 LLM(ChatGPT·Claude.ai·Gemini)에 붙여 넣을 제작 요청 프롬프트
#   api    = LLM API로 기획서·원고·대본·이미지 프롬프트까지 직접 생성 (유료)
#   auto   = API 시도, 크레딧 부족 등으로 실패한 부분만 제작 요청 프롬프트로 대체
GENERATION_MODE=prompt

# auto = Claude 키가 있으면 Claude, 없으면 Gemini, 둘 다 없으면 템플릿(LLM 없이)
LLM_PROVIDER=auto
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
GEMINI_MODEL=gemini-3.8-flash

# 이미지 생성: auto = OpenAI → Gemini → Pollinations(무료) 순으로 되는 것 사용
IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 쇼츠 영상: 나레이션 음성 female(선희) | male(인준) | multi(현수), 한글 폰트 경로(비우면 맑은 고딕/Noto CJK 자동)
SHORTS_VOICE=female
SHORTS_FONT=

# 카드뉴스(인스타 피드 PNG): cardnews-kit 스킬의 cardnews-engine/scripts 위치(비우면 프로젝트 .claude/skills/cardnews-engine/scripts),
# 카드 머리글·색 채널 키트(cardnews-<이름> 스킬, 비우면 무모한도전 키트 cardnews-mumohan → 없으면 starter)
CARDNEWS_ENGINE=
CARDNEWS_CHANNEL=
